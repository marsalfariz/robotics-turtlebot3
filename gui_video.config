<?xml version="1.0"?>
<!--
  Gazebo GUI layout for recording videos and close-up screenshots.
    ros2 launch line_follower sim.launch.py follow:=true \
        gui_config:=$(ros2 pkg prefix line_follower)/share/line_follower/config/gui_video.config
  Only the 3D view is shown. It uses the (deprecated but still working) GzScene3D plugin because in
  Fortress only GzScene3D offers video recording as a service:
    /gui/record_video  ignition.msgs.VideoRecord {start: true, format: "mp4", save_filename: "..."} / {stop: true}
    /gui/follow, /gui/follow/offset, /gui/move_to/pose, /gui/screenshot
  lockstep + sim time: the video plays at simulation speed even when CPU rendering is slow.
-->
<window>
  <width>1280</width>
  <height>760</height>
  <menus>
    <drawer default="false"/>
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<plugin filename="GzScene3D" name="3D View">
  <ignition-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </ignition-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <camera_pose>-0.6 -1.75 0.45 0 0.5 0.7</camera_pose>
  <camera_clip>
    <near>0.01</near>
    <far>100</far>
  </camera_clip>
  <record_video>
    <use_sim_time>true</use_sim_time>
    <lockstep>true</lockstep>
    <bitrate>2000000</bitrate>
  </record_video>
</plugin>

<!-- /gui/screenshot (tiny floating widget, not visible in recordings) -->
<plugin filename="Screenshot" name="Screenshot">
  <ignition-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </ignition-gui>
</plugin>
