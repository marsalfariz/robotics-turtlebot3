<?xml version="1.0"?>
<sdf version="1.8">
  <world name="line_following">
    <physics name="default" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.74 0.74 0.74 1</ambient><background>0.80 0.83 0.88 1</background></scene>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.70 0.70 0.70 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.3 0.1 -1</direction>
    </light>
    <model name="track">
      <static>true</static>
      <link name="floor">
        <collision name="ground">
          <pose>3 0 -0.05 0 0 0</pose>
          <geometry><box><size>12 6 0.10</size></box></geometry>
        </collision>
        <visual name="ground">
          <pose>3 0 -0.05 0 0 0</pose>
          <geometry><box><size>12 6 0.10</size></box></geometry>
          <material><ambient>0.86 0.86 0.86 1</ambient><diffuse>0.86 0.86 0.86 1</diffuse></material>
        </visual>
        <!-- TRACK_VISUALS -->
      </link>
    </model>
    <model name="line_robot">
      <pose>0 0 0.005 0 0 0</pose>
      <link name="chassis">
        <pose>0 0 0.088 0 0 0</pose>
        <inertial>
          <pose>-0.035 0 0 0 0 0</pose>
          <mass>1.4</mass>
          <inertia><ixx>0.006</ixx><iyy>0.010</iyy><izz>0.014</izz></inertia>
        </inertial>
        <collision name="chassis"><geometry><box><size>0.29 0.20 0.085</size></box></geometry></collision>
        <visual name="chassis">
          <geometry><box><size>0.29 0.20 0.085</size></box></geometry>
          <material><ambient>0.10 0.30 0.62 1</ambient><diffuse>0.11 0.42 0.80 1</diffuse></material>
        </visual>
        <collision name="rear_support">
          <pose>-0.12 0 -0.069 0 0 0</pose>
          <geometry><sphere><radius>0.019</radius></sphere></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="rear_support">
          <pose>-0.12 0 -0.069 0 0 0</pose>
          <geometry><sphere><radius>0.019</radius></sphere></geometry>
        </visual>
        <sensor name="line_camera" type="camera">
          <pose>0.18 0 0.155 0 0.94 0</pose>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <topic>/camera/image</topic>
          <camera>
            <horizontal_fov>1.10</horizontal_fov>
            <image><width>160</width><height>120</height><format>R8G8B8</format></image>
            <clip><near>0.03</near><far>4.0</far></clip>
          </camera>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0 0.124 0.048 1.5707963268 0 0</pose>
        <inertial><mass>0.12</mass><inertia><ixx>0.00009</ixx><iyy>0.00009</iyy><izz>0.00014</izz></inertia></inertial>
        <collision name="wheel"><geometry><cylinder><radius>0.048</radius><length>0.032</length></cylinder></geometry></collision>
        <visual name="wheel">
          <geometry><cylinder><radius>0.048</radius><length>0.032</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.124 0.048 1.5707963268 0 0</pose>
        <inertial><mass>0.12</mass><inertia><ixx>0.00009</ixx><iyy>0.00009</iyy><izz>0.00014</izz></inertia></inertial>
        <collision name="wheel"><geometry><cylinder><radius>0.048</radius><length>0.032</length></cylinder></geometry></collision>
        <visual name="wheel">
          <geometry><cylinder><radius>0.048</radius><length>0.032</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
      <joint name="left_joint" type="revolute">
        <parent>chassis</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="right_joint" type="revolute">
        <parent>chassis</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_joint</left_joint><right_joint>right_joint</right_joint>
        <wheel_separation>0.248</wheel_separation><wheel_radius>0.048</wheel_radius>
        <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
