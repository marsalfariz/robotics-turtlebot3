<?xml version="1.0" ?>
<!--
  line_robot: small differential-drive line follower (Gazebo Fortress, SDF 1.8)

  Frame: x = forward, y = left, z = up. Model origin is on the ground under the chassis centre.
    chassis       20 x 12 x 5 cm, bottom 1.5 cm above ground
    drive wheels  r = 3.5 cm, at x = -5 cm, y = +/-7.5 cm   (separation 15 cm)
    caster        frictionless ball r = 1.5 cm at x = +7 cm
    IR camera     40 x 4 px, 4 cm above ground at x = +11 cm, looking straight down
                  hfov 90 deg -> sees a strip ~8 cm wide x ~0.8 cm long on the floor
-->
<sdf version="1.8">
  <model name="line_robot">

    <!-- ===================== CHASSIS ===================== -->
    <link name="base_link">
      <pose>0 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.001127</ixx><iyy>0.002833</iyy><izz>0.003627</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.20 0.12 0.05</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>0.20 0.12 0.05</size></box></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>

      <!-- Caster: ball fixed under the front of the chassis, zero friction so it just slides -->
      <collision name="caster_collision">
        <pose>0.07 0 -0.025 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="caster_visual">
        <pose>0.07 0 -0.025 0 0 0</pose>
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>

      <!-- Sensor board (visual only): thin red bar in front, above the camera -->
      <visual name="sensor_board_visual">
        <pose>0.11 0 0.008 0 0 0</pose>
        <geometry><box><size>0.02 0.10 0.004</size></box></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- IR sensor array simulated with a tiny downward camera.
           pitch = +90 deg makes the camera look down; image left = robot left. -->
      <sensor name="ir_camera" type="camera">
        <pose>0.11 0 0 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>ir_camera/image</topic>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image><width>40</width><height>4</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>1.0</far></clip>
        </camera>
      </sensor>
    </link>

    <!-- ===================== WHEELS ===================== -->
    <!-- Cylinders point along z by default; roll -90 deg turns them to point along y -->
    <link name="left_wheel">
      <pose>-0.05 0.075 0.035 -1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.7e-5</ixx><iyy>1.7e-5</iyy><izz>3.06e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.035</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.035</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>-0.05 -0.075 0.035 -1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.7e-5</ixx><iyy>1.7e-5</iyy><izz>3.06e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.035</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.035</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <!-- ===================== DIFF DRIVE ===================== -->
    <!-- Listens on /cmd_vel (Twist), publishes /odom (Odometry) -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.15</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- ===================== GROUND TRUTH ===================== -->
    <!-- True pose from the physics engine (not affected by wheel slip), for evaluation only.
         The controller never uses it. Published on /ground_truth. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>line_robot</robot_base_frame>
      <odom_topic>/ground_truth</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
